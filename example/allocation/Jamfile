# Requires mimalloc (https://github.com/microsoft/mimalloc)
# installed where the compiler can find it.

project
    : requirements
      <library>/boost/capy//boost_capy
      <include>.
    ;

exe allocation :
    [ glob *.cpp ]
    :
    <linkflags>-lmimalloc
    ;
