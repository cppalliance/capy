import ac ;
import testing ;

project
    : requirements
      $(c20-requires)
      <library>/boost/capy//boost_capy
      <source>../../../url/extra/test_suite/test_main.cpp
      <source>../../../url/extra/test_suite/test_suite.cpp
      <include>.
      <include>../..
      <include>../../../url/extra/test_suite
      <warnings>extra
      <warnings-as-errors>on
      <target-os>darwin,<undefined-sanitizer>norecover:<link>static
    ;

for local f in [ glob-tree-ex . : *.cpp : file*.cpp ]
{
    run $(f) ;
}

for local f in [ glob-tree-ex . : file*.cpp ]
{
    run $(f)
        : requirements
          <warnings>off <undefined-sanitizer>norecover:<link>static
        ;
}
