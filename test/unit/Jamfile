import ac ;
import testing ;

lib ws2_32 ; # NT
lib bcrypt ; # NT

project
    : requirements
      $(c20-requires)
      <library>/boost/capy//boost_capy
      <source>../../extra/test_suite/test_main.cpp
      <source>../../extra/test_suite/test_suite.cpp
      <include>.
      <include>../..
      <include>../../extra/test_suite
      <warnings>extra
      <warnings-as-errors>on
      <target-os>darwin,<undefined-sanitizer>norecover:<link>static
      # Windows asio comp layer
      <target-os>windows,<toolset>cw:<library>ws2_32
      <target-os>windows,<toolset>gcc:<library>ws2_32
      <target-os>windows,<toolset>clang:<library>ws2_32
      <target-os>windows,<toolset>clang:<library>bcrypt
    ;

for local f in [ glob-tree-ex . : *.cpp : file*.cpp ]
{
    local parts = [ SPLIT_BY_CHARACTERS $(f:S=) : / ] ;
    local name = $(parts:J=_) ;
    if $(name) = test_stream
    {
        # GCC false positive: structured bindings used inside
        # coroutine frames trigger -Wmaybe-uninitialized because
        # the coroutine lowering pass splits the code into a state
        # machine, and GCC's dataflow analysis cannot prove that
        # the anonymous temporary from
        # `auto [a, b] = make_stream_pair(f)` is fully initialized.
        run $(f)
            : target-name $(name)
            : requirements
              <toolset>gcc:<cxxflags>-Wno-maybe-uninitialized
            ;
    }
    else
    {
        run $(f) : target-name $(name) ;
    }
}

for local f in [ glob-tree-ex . : file*.cpp ]
{
    local parts = [ SPLIT_BY_CHARACTERS $(f:S=) : / ] ;
    run $(f)
        : target-name $(parts:J=_)
        : requirements
          <warnings>off <undefined-sanitizer>norecover:<link>static
        ;
}
